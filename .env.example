# Copy this file to .env and fill in your values.

# PayPal Developer Dashboard -> Apps & Credentials -> (Sandbox) your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Any Claude model works. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Optional
PORT=3000
BASE_URL=http://localhost:3000

# Comma-separated PayPal SANDBOX personal account emails, one per demo member
# (Maria, Ayesha, Dev, Luz, Tomas). Payouts go to these.
DEMO_EMAILS=
