# Copy this file to .env and fill in your values.

# PayPal Developer Dashboard -> Apps & Credentials -> (Sandbox) your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: PayPal webhooks. Create a webhook in your sandbox app pointing at
# <your public URL>/api/paypal/webhook and paste its Webhook ID here.
# Webhooks need a public URL (e.g. the Render deploy); on localhost the app checks PayPal directly instead.
PAYPAL_WEBHOOK_ID=

# AI coordinator: set ONE of these keys. If both are set, Gemini is used.
# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Or Anthropic Claude. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Comma-separated PayPal SANDBOX personal account emails, one per demo member
# (Maria, Ayesha, Dev, Luz, Tomas). Demo payouts go to these.
DEMO_EMAILS=

# Optional
PORT=3000
BASE_URL=http://localhost:3000
# AI requests allowed per visitor IP per hour (protects your AI quota on a public deploy)
AI_LIMIT_PER_HOUR=40
# Where circles are stored (default: data.json next to server.js)
# DATA_FILE=
